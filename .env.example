# Optional: pin MCP Bearer token (otherwise auto-generated into the mcp-data volume)
# API_KEY=

# Optional: absolute path inside the mcp container for user strategy YAML
# CONFIG_DIR=/config

# Successful crawl cache TTL in seconds (0 disables). Default 60.
# CRAWL_CACHE_TTL_SEC=60

# Note: this Compose stack pins cloakhq/cloakbrowser:0.6.5 (keyless).
# Newer images (0.7+) need CLOAKBROWSER_LICENSE_KEY instead.
